erDiagram
  BUSINESSES ||--o{ LOANS : owns
  LOANS ||--o{ LOAN_INSTALLMENTS : schedules

  BUSINESSES {
    uuid id PK
    varchar name
    timestamp created_at
  }
  LOANS {
    uuid id PK
    uuid business_id FK
    decimal principal
    char currency_code
    decimal annual_rate
    int installment_count
    date first_due_date
    timestamp created_at
  }
  LOAN_INSTALLMENTS {
    uuid id PK
    uuid loan_id FK
    int installment_number
    date due_date
    decimal amount
    varchar status
  }
