erDiagram
  BUSINESSES ||--o{ SUPPLIERS : owns
  BUSINESSES ||--o{ PURCHASES : owns
  SUPPLIERS ||--o{ PURCHASES : supplies
  PURCHASES ||--o{ PAYMENTS : receives

  BUSINESSES {
    uuid id PK
    varchar name
    timestamp created_at
  }
  SUPPLIERS {
    uuid id PK
    uuid business_id FK
    varchar name
    varchar tax_identifier
    timestamp created_at
  }
  PURCHASES {
    uuid id PK
    uuid business_id FK
    uuid supplier_id FK
    char currency_code
    decimal total_amount
    varchar document_reference
    varchar description
    date purchased_on
    date due_date
    varchar receipt_url
    varchar status
    timestamp created_at
  }
  PAYMENTS {
    uuid id PK
    uuid purchase_id FK
    decimal amount
    date paid_on
    varchar voucher_url
    timestamp created_at
  }
